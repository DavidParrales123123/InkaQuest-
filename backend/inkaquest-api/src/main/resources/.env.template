# =============================================================================
# TEMPLATE DE VARIABLES DE ENTORNO - InkaQuest API
# =============================================================================
# Copiar a .env en la raíz del proyecto y completar con valores reales
# NUNCA versionar el archivo .env con credenciales reales
# =============================================================================

# --- Perfil de Spring Boot ---------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# --- Servidor ----------------------------------------------------------------
SERVER_PORT=8080

# --- Base de Datos (Supabase PostgreSQL) ------------------------------------
DB_URL=jdbc:postgresql://db.nrfdifzechrjikrvzhdl.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX_SIZE=10

# --- Supabase Auth (JWT Validation) ------------------------------------------
SUPABASE_URL=https://nrfdifzechrjikrvzhdl.supabase.co

# Opción 1: JWKS (ES256 - Recomendado para producción)
SUPABASE_JWKS_URI=https://nrfdifzechrjikrvzhdl.supabase.co/auth/v1/.well-known/jwks.json

# Opción 2: JWT Secret (HS256 - Solo para desarrollo/legacy)
# Dejar vacío si usas JWKS
SUPABASE_JWT_SECRET=

# Service Role Key - Solo backend, operaciones admin, bypasea RLS
# NUNCA exponer en frontend ni en logs
SUPABASE_SERVICE_ROLE_KEY=

# Anon Key - Clave pública, se puede compartir con frontend
SUPABASE_ANON_KEY=

# --- CORS --------------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.up.railway.app

# --- Seguridad ---------------------------------------------------------------
# Rate Limiting (requests por minuto)
RATE_LIMIT_MAX_PER_MINUTE=60
RATE_LIMIT_STRICT_PER_MINUTE=20

# --- Culqi (Pagos) -----------------------------------------------------------
# Clave secreta de Culqi - NUNCA exponer en frontend
CULQI_API_KEY=
CULQI_API_BASE=https://api.culqi.com/v2

# --- Chatbot IA --------------------------------------------------------------
# API Key del proveedor de IA - NUNCA exponer
CHATBOT_API_KEY=
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
CHATBOT_MODEL=gpt-4o-mini

# --- Logging -----------------------------------------------------------------
LOG_LEVEL_INKAQUEST=INFO

# =============================================================================
# CHECKLIST DE SEGURIDAD:
# =============================================================================
# ✅ SUPABASE_SERVICE_ROLE_KEY está configurado y NUNCA se expone
# ✅ CULQI_API_KEY está configurado y NUNCA se expone
# ✅ CHATBOT_API_KEY está configurado y NUNCA se expone
# ✅ DB_PASSWORD es fuerte y único
# ✅ CORS está restringido a dominios específicos
# ✅ Rate limiting está activado
# ✅ JWKS_URI está configurado (preferido sobre JWT_SECRET)
# ✅ Log level es INFO o superior en producción
# ✅ Todas las URLs usan HTTPS en producción
# =============================================================================
