# =============================================================================
# INKAQUEST API — plantilla de variables de entorno
# Copiar a .env y rellenar con valores reales. NUNCA versionar .env real.
# =============================================================================

# --- Perfil Spring (local | development | test | production) -----------------
SPRING_PROFILES_ACTIVE=local

# --- Servidor -----------------------------------------------------------------
SERVER_PORT=8080

# --- Base de datos PostgreSQL (Supabase) --------------------------------------
DB_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=<PASSWORD>

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# JWKS de Auth para validar JWT (ES256 en este proyecto). NO agregar HS256 secret
# salvo que el proyecto use firma legacy HS256.
SUPABASE_JWKS_URI=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
# Dejar vacío si el proyecto usa ES256/JWKS; solo para proyectos HS256 legacy.
SUPABASE_JWT_SECRET=

# --- CORS (orígenes permitidos, separados por coma) ---------------------------
APP_SECURITY_ALLOWED_ORIGINS=https://inkaquest.com,https://app.inkaquest.com

# --- Culqi (pagos) ------------------------------------------------------------
# Clave SECRETA de Culqi (solo servidor). Sin ella, los cobros quedan deshabilitados.
CULQI_API_KEY=
# URL base de la API Culqi (v2).
CULQI_API_BASE=https://api.culqi.com/v2
# La autenticidad se verifica consultando el evento y cargo en la API privada de Culqi.
# No se requiere ni se presupone un header HMAC no documentado.

# --- Proveedor de IA para Chatbot (solo backend) -------------------------------
CHATBOT_API_KEY=
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
CHATBOT_MODEL=gpt-4o-mini

# --- Logging (INFO en production, DEBUG solo local) ---------------------------

# =============================================================================
# Producción: HTTPS obligatorio, CORS restringido, actuator reducido.
# Ver docs/backend/RESUMEN-IMPLEMENTACION.md y docs/backend/secciones-23-40.md
# =============================================================================
