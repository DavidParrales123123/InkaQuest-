# Editor configuration — InkaQuest
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{ts,js,json,html,scss,css,yml,yaml}]
indent_size = 2

[*.java]
indent_size = 4
max_line_length = 120

[*.{md,sql}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
