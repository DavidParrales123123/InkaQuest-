# =============================================================================
# INKAQUEST - Variables de entorno (plantilla)
# -----------------------------------------------------------------------------
# Copia este archivo como `.env` (frontend) o `.env.backend` (backend) y
# reemplaza los valores. NUNCA subas archivos con valores reales a Git.
#
# Convenciones:
#   - `VITE_*` -> inyectadas en el bundle del navegador por Angular/Vite.
#     Solo se admiten claves PÚBLICAS de Supabase.
#   - Sin prefijo `VITE_` -> solo las usa el backend (Render/Railway).
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (servicio de datos, auth y storage)
# Obtener en: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA_NUEVA
# Solo backend. NUNCA exponla en el frontend.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE
# Solo backend. Necesaria para validar los JWT emitidos por Supabase Auth.
SUPABASE_JWT_SECRET=
# Preferido para el proyecto actual con firma ES256.
SUPABASE_JWKS_URI=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# -----------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (backend -> Supabase PostgreSQL)
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://db.TU-PROYECTO.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=TU_PASSWORD_DE_LA_BASE_DE_DATOS
DB_POOL_MAX_SIZE=10

# -----------------------------------------------------------------------------
# FRONTEND (Angular / Vercel)
# -----------------------------------------------------------------------------
# URL base del backend Spring Boot, ya con el sufijo /api/v1.
VITE_API_URL=https://TU-BACKEND.onrender.com/api/v1
# URL del proyecto Supabase (clave pública).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon / publishable) de Supabase.
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# -----------------------------------------------------------------------------
# CORS / SEGURIDAD (backend)
# -----------------------------------------------------------------------------
# Origenes del frontend permitidos, separados por coma.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://inkaquest-web.vercel.app
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:4200,https://TU-APP.vercel.app

# -----------------------------------------------------------------------------
# SPRING BOOT (backend)
# -----------------------------------------------------------------------------
SERVER_PORT=8080
# Perfil activo: local | prod
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL_INKAQUEST=INFO

# -----------------------------------------------------------------------------
# PAGOS (Culqi) - opcional, se habilita en fases posteriores
# -----------------------------------------------------------------------------
# Clave privada de Culqi (solo backend). Usar sk_test_* en Sandbox.
CULQI_API_KEY=
CULQI_API_BASE=https://api.culqi.com/v2
# La validación del webhook se realiza consultando el evento a Culqi con CULQI_API_KEY.
# No se presupone un header HMAC que la documentación oficial no define.

# -----------------------------------------------------------------------------
# CHATBOT IA (solo backend; proveedor compatible con OpenAI)
# -----------------------------------------------------------------------------
CHATBOT_API_KEY=
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
CHATBOT_MODEL=gpt-4o-mini
