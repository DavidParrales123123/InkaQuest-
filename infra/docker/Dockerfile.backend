# =============================================================================
# INKAQUEST API - Imagen de producción (multi-stage)
# -----------------------------------------------------------------------------
# Se usa para desplegar el backend Spring Boot en Render, Railway, Fly.io o
# cualquier proveedor compatible con contenedores.
#
# Build:  docker build -f infra/docker/Dockerfile.backend -t inkaquest-api .
# Run:    docker run -p 8080:8080 --env-file .env.backend inkaquest-api
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: compilación con Maven y JDK 25
# -----------------------------------------------------------------------------
FROM maven:3.10-eclipse-temurin-25 AS builder

WORKDIR /build

# Se copia primero el pom para aprovechar la caché de Docker de las dependencias.
COPY backend/inkaquest-api/pom.xml ./pom.xml
RUN mvn -B dependency:go-offline

COPY backend/inkaquest-api/src ./src
RUN mvn -B clean package -DskipTests

# -----------------------------------------------------------------------------
# Stage 2: imagen de ejecución mínima con JRE 25
# -----------------------------------------------------------------------------
FROM eclipse-temurin:25-jre-alpine AS runtime

# Usuario sin privilegios para reducir el impacto de una eventual vulnerabilidad.
RUN addgroup -S inkaquest && adduser -S inkaquest -G inkaquest

WORKDIR /app

# Copia únicamente el artefacto empaquetado desde la etapa de compilación.
COPY --from=builder /build/target/inkaquest-api-*.jar app.jar

USER inkaquest

EXPOSE 8080

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport"

# El endpoint de salud de Actuator sirve como sonda de disponibilidad.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
